{
  "version": 4,
  "configurations": [
    {
      "name": "ESP-IDF",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/components/hw_hal/include",
        "${workspaceFolder}/components/kernel/include",
        "${workspaceFolder}/components/ui/include",
        "${workspaceFolder}/main"
      ],
      "cStandard": "c11",
      "intelliSenseMode": "gcc-x64"
    },
    {
      "name": "Host tests",
      "includePath": [
        "${workspaceFolder}/components/kernel/include",
        "${workspaceFolder}/test/host"
      ],
      "defines": ["HOST_BUILD=1"],
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ]
}
